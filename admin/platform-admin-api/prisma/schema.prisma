generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  websiteUrl           String
  dbName               String   @unique
  dbUrl                String?  @map("db_url")
  openreplayProjectKey String?
  createdAt            DateTime @default(now())
}

